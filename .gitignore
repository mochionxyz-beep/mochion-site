# dependencies / build
node_modules/
dist/
.cache/
.wrangler/

# deploy-time artifacts (generated by the GitHub Action; never committed)
# root-anchored: /og is the generated card dir; assets/og (static cards) IS committed
/og/
/feed.xml

# same-day handoff between draft-posts.mjs and approve-post.mjs — travels as
# a short-retention GitHub Actions artifact, never as a commit (candidates
# not yet approved would otherwise become permanently public in git history)
ci/.draft-output/

# secrets & local infra — NEVER commit
.env
.env.*
*.pem
.aws/
aws-exports.js
**/credentials
terraform.tfstate*
.terraform/

# os / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# private analytics — audience / X / Search-Console growth log; NEVER publish
data/metrics.jsonl
